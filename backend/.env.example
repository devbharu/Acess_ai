# ==========================================
# AccessAI Backend Environment Configuration
# ==========================================

# Server Network Configuration
PORT=5001
HOST=0.0.0.0
FLASK_DEBUG=True

# Authentication & Security
# Change these secrets in production!
SECRET_KEY=accessai-super-secret-key-2026-prod
JWT_SECRET=accessai_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Database Path (default: data/accessai.db inside backend)
DATABASE_PATH=data/accessai.db

# LLM & AI Service (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Data Directories (optional overrides, defaults to backend/data/*)
# UPLOADS_DIR=data/uploads
# AUDIO_DIR=data/audio
# FAISS_DIR=data/faiss_indices
# ARTIFACTS_DIR=data/artifacts
