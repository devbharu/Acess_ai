# ==========================================
# AccessAI Backend Environment Configuration
# ==========================================

# ------------------------------------------
# 1. AI Service (Required on Render)
# ------------------------------------------
# Your Groq API key (starts with gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------
# 2. Production Security & Auth (Required on Render)
# ------------------------------------------
# Generate secure random strings for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-random-secret-key-for-production
JWT_SECRET=replace-with-a-random-jwt-secret-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# ------------------------------------------
# 3. Server & Runtime (Render Web Service)
# ------------------------------------------
# Render automatically sets PORT (e.g. 10000). Leave commented or set for local dev:
PORT=5001
HOST=0.0.0.0
FLASK_DEBUG=False
PYTHON_VERSION=3.12.0

# ------------------------------------------
# 4. Storage & Database (SQLite / Persistent Disk)
# ------------------------------------------
# Default SQLite database path (ephemeral unless Render Disk is attached):
DATABASE_PATH=data/accessai.db
# If using a Render Persistent Disk mounted at /var/data:
# DATABASE_PATH=/var/data/accessai.db

# Optional data directory overrides (defaults to backend/data/*)
# UPLOADS_DIR=data/uploads
# AUDIO_DIR=data/audio
# FAISS_DIR=data/faiss_indices
# ARTIFACTS_DIR=data/artifacts
