# ===========================================
# AccessAI Frontend Environment Configuration
# ===========================================

# API Base URL
# Leave empty in development to route through Vite proxy (/api -> http://localhost:5001)
# For production or direct backend access, set to backend server URL:
# VITE_API_URL=http://localhost:5001
VITE_API_URL=

# Vite Dev Server Proxy Target (used in vite.config.js for local dev proxy)
BACKEND_URL=http://localhost:5001
